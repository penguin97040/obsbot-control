// Resources: icon, manifest and version info (language en-NZ, 0x1409).
#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"


VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "140904b0"
        BEGIN
            VALUE "CompanyName", "obsbot-control contributors"
            VALUE "FileDescription", "obsbot-control: open-source OBSBOT camera control (unofficial)"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "obsbot-control"
            VALUE "LegalCopyright", "Copyright (c) 2026 penguin97040. MIT Licence."
            VALUE "OriginalFilename", "obsbot-control.exe"
            VALUE "ProductName", "obsbot-control"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x1409, 1200
    END
END
